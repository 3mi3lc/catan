# Copy to .env (gitignored) and fill in for local dev.

PORT=8080

# Must be the web app's exact origin once auth is in use — "*" is rejected
# at startup, since browsers refuse credentialed cross-origin requests
# against a wildcard Access-Control-Allow-Origin anyway.
CORS_ORIGIN=http://localhost:5173

# docker compose up postgres   (see docker-compose.yml at the repo root)
DATABASE_URL=postgres://catan:catan@localhost:5432/catan

# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# Must be kept secret — anyone with this value can forge sessions.
BETTER_AUTH_SECRET=

BETTER_AUTH_URL=http://localhost:8080
