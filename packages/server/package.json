{
  "name": "@catan/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "predev": "docker compose -f ../../docker-compose.yml up -d postgres",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "prestart": "docker compose -f ../../docker-compose.yml up -d postgres",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "predb:migrate": "docker compose -f ../../docker-compose.yml up -d postgres",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@catan/ai": "workspace:*",
    "@catan/core": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "better-auth": "^1.2.7",
    "drizzle-orm": "^0.38.3",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1",
    "socket.io-client": "^4.8.1",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
